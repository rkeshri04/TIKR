# --- AI engine -------------------------------------------------------------
# Which engine writes the research note and answers follow-up questions:
#   auto         (default) Claude API if ANTHROPIC_API_KEY is set, else the
#                Claude Code CLI if it's installed, else the built-in analyst
#   api          Claude API, billed to ANTHROPIC_API_KEY
#   claude-code  The Claude Code CLI installed on this machine, using its own
#                login (e.g. your Pro/Max plan). Run `claude` once and sign in.
#                Any ANTHROPIC_API_KEY below is NOT passed to it, so usage
#                counts against the Claude Code login rather than the API.
#   local        No AI: built-in rules-based analyst only
TIKR_AI_PROVIDER=auto

# --- Claude API (TIKR_AI_PROVIDER=api or auto) -----------------------------
ANTHROPIC_API_KEY=
TIKR_MODEL=claude-opus-5-5

# --- Claude Code CLI (TIKR_AI_PROVIDER=claude-code or auto) ----------------
# Path to the CLI if `claude` isn't on the server's PATH
# TIKR_CLAUDE_BIN=/usr/local/bin/claude
# Model for Claude Code (leave unset to use the CLI's default for your plan)
# TIKR_CLAUDE_CODE_MODEL=claude-opus-5-5
# Kill a run that takes longer than this (ms)
# TIKR_CLAUDE_CODE_TIMEOUT_MS=300000

# --- Shared AI settings ----------------------------------------------------
# Reasoning effort: low / medium / high / xhigh / max (lower = faster, cheaper)
TIKR_EFFORT=high
# Let the analyst run its own web searches (1 = on, 0 = off)
TIKR_WEB_SEARCH=1

# --- SEC EDGAR -------------------------------------------------------------
# The SEC asks automated clients to identify themselves with a contact.
# Put your app name and a real email here.
SEC_USER_AGENT="TIKR-research-app contact@example.com"
