# --- LLM (optional but recommended) -------------------------------------
# With a key, TIKR writes a full AI research report and answers follow-up
# questions using Claude (with live web search). Without one, it falls back
# to a built-in rules-based quant report — everything else still works.
ANTHROPIC_API_KEY=

# Model + effort (defaults shown)
TIKR_MODEL=claude-opus-5-5
TIKR_EFFORT=high
# Let Claude run its own web searches during research (1 = on, 0 = off)
TIKR_WEB_SEARCH=1

# --- SEC EDGAR -----------------------------------------------------------
# The SEC asks automated clients to identify themselves with a contact.
# Put your app name and a real email here.
SEC_USER_AGENT="TIKR-research-app contact@example.com"
